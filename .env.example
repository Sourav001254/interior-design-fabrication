PORT=4010
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here
VITE_WHATSAPP_NUMBER=your_whatsapp_number_here
APP_URL=http://localhost:4010

# Copy this file to `.env` and fill real values locally. Do NOT commit `.env`.# GEMINI_API_KEY: Optional. Enables the AI design co-pilot.
GEMINI_API_KEY="your_gemini_api_key"

# GEMINI_MODEL: Optional. Override the model used by the AI design co-pilot.
GEMINI_MODEL="gemini-2.5-flash"

# Admin portal credentials. Change these before sharing or deploying.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-strong-password"

# WhatsApp number used by the contact form, digits only with country code.
VITE_WHATSAPP_NUMBER="919851451319"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
